# Hedera Testnet only. All private keys are server-side secrets.
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=
HEDERA_TREASURY_ACCOUNT_ID=
HEDERA_TREASURY_PRIVATE_KEY=
HEDERA_SUPPLY_PRIVATE_KEY=
HEDERA_HCS_ADMIN_PRIVATE_KEY=
HEDERA_HCS_SUBMIT_PRIVATE_KEY=

HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com
HEDERA_EXPLORER_BASE_URL=https://hashscan.io/testnet
HEDERA_REQUEST_TIMEOUT_MS=15000
HEDERA_RECEIPT_TIMEOUT_MS=30000
HEDERA_MAX_ATTEMPTS=3
HEDERA_MIRROR_REQUEST_TIMEOUT_MS=10000
HEDERA_MIRROR_VERIFICATION_TIMEOUT_MS=15000
HEDERA_MIRROR_POLL_INTERVAL_MS=750
HEDERA_MIRROR_MAX_ATTEMPTS=4
HEDERA_MAX_TRANSACTION_FEE_HBAR=10
HEDERA_MAX_QUERY_PAYMENT_HBAR=2

# Script-only state. These paths are ignored by Git.
STAGE_HEDERA_STATE_FILE=.stage-hedera/testnet-state.json
STAGE_HEDERA_IDEMPOTENCY_FILE=.stage-hedera/idempotency.json

# Fungible reward flow.
STAGE_TOKEN_NAME=Stage Creator Credit
STAGE_TOKEN_SYMBOL=STAGEC
STAGE_TOKEN_DECIMALS=2
STAGE_TOKEN_INITIAL_SUPPLY=0
STAGE_FUNGIBLE_TOKEN_ID=
STAGE_MINT_ID=
STAGE_MINT_AMOUNT=
STAGE_USER_ACCOUNT_ID=
STAGE_RECIPIENT_ACCOUNT_ID=
STAGE_REWARD_ID=
STAGE_TRANSFER_AMOUNT=
STAGE_LAST_TRANSACTION_ID=

# Testnet-only wallet demonstration. Never use a production user key here.
STAGE_USER_PRIVATE_KEY=

# HCS flow.
STAGE_HCS_TOPIC_ID=
STAGE_HCS_TOPIC_MEMO=Stage audit events v1
STAGE_AUDIT_EVENT_ID=
STAGE_AUDIT_EVENT_TYPE=reward_paid
STAGE_AUDIT_OCCURRED_AT=
STAGE_AUDIT_CREATOR_ID=

# NFT flow. Run only after the fungible reward flow is verified.
STAGE_NFT_NAME=Stage Claim
STAGE_NFT_SYMBOL=STGCLM
STAGE_NFT_MAX_SUPPLY=10000
STAGE_NFT_TOKEN_ID=
STAGE_NFT_METADATA={"name":"Stage Claim","type":"perk"}
STAGE_NFT_MINT_ID=
STAGE_NFT_SERIAL_TO_BURN=
