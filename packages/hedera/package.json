{
  "name": "@creator-platform/hedera",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "lint": "eslint src",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test",
    "hedera:setup": "node ../../scripts/hedera-setup.mjs",
    "hedera:create-topic": "node ../../scripts/hedera-create-topic.mjs",
    "hedera:create-demo-token": "node ../../scripts/hedera-create-demo-token.mjs"
  },
  "dependencies": {
    "@creator-platform/shared": "workspace:*",
    "@hashgraph/sdk": "^2.0.0"
  }
}
