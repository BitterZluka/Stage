generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChallengeStatus {
  DRAFT
  PUBLISHED
  JUDGING
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  SUBMITTED
  WINNER
  REJECTED
}

enum SubmissionKind {
  LINK
  VIDEO
  IMAGE
  TEXT
}

enum VerificationMode {
  MANUAL
  AUTOMATIC
  HYBRID
}

enum OperationStatus {
  PENDING
  PROCESSING
  SUBMITTED
  CONFIRMED
  FAILED
  NEEDS_REVIEW
}

enum RewardType {
  PARTICIPATION
  WINNER
}

enum ClaimStatus {
  CLAIMED
  FULFILLED
  CANCELLED
}

enum PerkStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXHAUSTED
}

enum CreatorStatus {
  ACTIVE
  SUSPENDED
}

enum UserIntent {
  FAN
  CREATOR
}

model User {
  id                    String              @id @default(uuid())
  primaryIntent         UserIntent?
  onboardingCompletedAt DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  wallets               Wallet[]
  creator               Creator?
  submissions           Submission[]
  rewardReservations    RewardReservation[]
  rewardPayouts         RewardPayout[]
  worldIdentity         WorldIdentity?
  claims                Claim[]
  sessions              Session[]
}

model Wallet {
  id         String   @id @default(uuid())
  userId     String
  accountId  String   @unique
  publicKey  String?
  verifiedAt DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginChallenge {
  id        String    @id @default(uuid())
  accountId String
  message   String
  nonceHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([accountId, expiresAt])
}

model Session {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Creator {
  id          String        @id @default(uuid())
  ownerUserId String        @unique
  handle      String        @unique
  displayName String
  status      CreatorStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  owner       User          @relation(fields: [ownerUserId], references: [id])
  token       CreatorToken?
  challenges  Challenge[]
  perks       Perk[]
}

model CreatorToken {
  id            String   @id @default(uuid())
  creatorId     String   @unique
  hederaTokenId String?  @unique
  name          String
  symbol        String
  decimals      Int
  totalSupply   String
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  creator       Creator  @relation(fields: [creatorId], references: [id])

  // OPEN QUESTION: fixed supply for MVP or retain a supply key for future minting?
}

model Challenge {
  id                        String              @id @default(uuid())
  creatorId                 String
  title                     String
  description               String
  status                    ChallengeStatus     @default(DRAFT)
  submissionKind            SubmissionKind
  verificationMode          VerificationMode    @default(MANUAL)
  verificationConfig        Json?
  startsAt                  DateTime
  submissionDeadline        DateTime
  participationTokenAmount  String              @default("0")
  requiresWorldVerification Boolean             @default(true)
  version                   Int                 @default(1)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  creator                   Creator             @relation(fields: [creatorId], references: [id])
  submissions               Submission[]
  rewardRule                RewardRule?
  reservations              RewardReservation[]
  worldRewardClaims         WorldRewardClaim[]
}

model Submission {
  id                 String              @id @default(uuid())
  challengeId        String
  authorUserId       String
  status             SubmissionStatus    @default(SUBMITTED)
  text               String?
  artifactRefs       Json?
  reviewNote         String?
  reviewedAt         DateTime?
  version            Int                 @default(1)
  createdAt          DateTime            @default(now())
  challenge          Challenge           @relation(fields: [challengeId], references: [id])
  author             User                @relation(fields: [authorUserId], references: [id])
  rewardReservations RewardReservation[]

  @@unique([challengeId, authorUserId])
}

model RewardRule {
  id                  String    @id @default(uuid())
  challengeId         String    @unique
  participationAmount String    @default("0")
  amount              String
  maxWinners          Int       @default(1)
  challenge           Challenge @relation(fields: [challengeId], references: [id])
}

model RewardReservation {
  id           String          @id @default(uuid())
  challengeId  String
  submissionId String
  recipientId  String
  rewardType   RewardType
  amount       String
  status       OperationStatus @default(PENDING)
  createdAt    DateTime        @default(now())
  challenge    Challenge       @relation(fields: [challengeId], references: [id])
  submission   Submission      @relation(fields: [submissionId], references: [id])
  recipient    User            @relation(fields: [recipientId], references: [id])
  payout       RewardPayout?

  @@unique([submissionId, rewardType])
  @@unique([challengeId, recipientId, rewardType])
}

model RewardPayout {
  id            String            @id @default(uuid())
  reservationId String            @unique
  recipientId   String
  amount        String
  status        OperationStatus   @default(PENDING)
  transactionId String?           @unique
  requestedAt   DateTime          @default(now())
  confirmedAt   DateTime?
  reservation   RewardReservation @relation(fields: [reservationId], references: [id])
  recipient     User              @relation(fields: [recipientId], references: [id])
}

model WorldIdentity {
  id              String             @id @default(uuid())
  userId          String             @unique
  provider        String
  protocolVersion String
  credentialType  String
  subjectKey      String?            @unique
  sessionId       String?            @unique
  signalHash      String
  verifiedAt      DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  proofReplays    WorldProofReplay[]
  rewardClaims    WorldRewardClaim[]
}

model WorldProofReplay {
  id              String        @id @default(uuid())
  worldIdentityId String
  action          String
  replayKey       String
  protocolVersion String
  credentialType  String
  acceptedAt      DateTime      @default(now())
  worldIdentity   WorldIdentity @relation(fields: [worldIdentityId], references: [id], onDelete: Cascade)

  @@unique([action, replayKey])
  @@index([worldIdentityId, acceptedAt])
}

model WorldRewardClaim {
  id              String        @id @default(uuid())
  worldIdentityId String
  challengeId     String
  rewardType      String
  createdAt       DateTime      @default(now())
  worldIdentity   WorldIdentity @relation(fields: [worldIdentityId], references: [id], onDelete: Cascade)
  challenge       Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, worldIdentityId, rewardType])
  @@index([worldIdentityId, createdAt])
}

model Perk {
  id                        String     @id @default(uuid())
  creatorId                 String
  title                     String
  description               String
  tokenThreshold            String
  inventory                 Int
  claimedCount              Int        @default(0)
  status                    PerkStatus @default(DRAFT)
  requiresWorldVerification Boolean    @default(true)
  version                   Int        @default(1)
  claimNftTokenId           String?
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt
  creator                   Creator    @relation(fields: [creatorId], references: [id])
  claims                    Claim[]

  @@index([creatorId, status, createdAt])
}

model Claim {
  id                  String           @id @default(uuid())
  perkId              String
  claimantId          String
  status              ClaimStatus      @default(CLAIMED)
  eligibilitySnapshot Json?
  fulfillmentNote     String?
  fulfilledAt         DateTime?
  version             Int              @default(1)
  nftTokenId          String?
  nftSerial           String?
  fulfillmentData     Json?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  perk                Perk             @relation(fields: [perkId], references: [id])
  claimant            User             @relation(fields: [claimantId], references: [id])
  redemption          ClaimRedemption?

  @@unique([perkId, claimantId])
  @@unique([nftTokenId, nftSerial])
  @@index([claimantId, createdAt])
}

model ClaimRedemption {
  id          String    @id @default(uuid())
  claimId     String    @unique
  requestedAt DateTime  @default(now())
  fulfilledAt DateTime?
  burnTxId    String?   @unique
  claim       Claim     @relation(fields: [claimId], references: [id])
}

model AuditEvent {
  id            String   @id @default(uuid())
  eventType     String
  entityId      String
  actorId       String?
  payload       Json
  publicPayload Json?
  occurredAt    DateTime @default(now())
  hcsSequence   String?

  @@index([entityId, occurredAt])
}

model BlockchainTransaction {
  id                  String          @id @default(uuid())
  idempotencyKey      String          @unique
  operationType       String
  requestHash         String
  status              OperationStatus @default(PENDING)
  hederaTransactionId String?         @unique
  result              Json?
  attempts            Int             @default(0)
  lastErrorCode       String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model OutboxEvent {
  id             String          @id @default(uuid())
  idempotencyKey String          @unique
  eventType      String
  aggregateId    String
  payload        Json
  status         OperationStatus @default(PENDING)
  attempts       Int             @default(0)
  availableAt    DateTime        @default(now())
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())

  @@index([status, availableAt])
}
