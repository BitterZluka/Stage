{
  "name": "@creator-platform/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "node --env-file-if-exists=\"../../.env\" --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "node --import tsx --test src/auth/*.test.ts src/world/*.test.ts src/challenges/*.test.ts src/submissions/*.test.ts src/perks/*.test.ts src/claims/*.test.ts src/catalog/*.test.ts src/tokens/*.test.ts"
  },
  "dependencies": {
    "@creator-platform/database": "workspace:*",
    "@creator-platform/hedera": "workspace:*",
    "@creator-platform/shared": "workspace:*",
    "@stage/world": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "bullmq": "^5.81.2",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1"
  }
}
