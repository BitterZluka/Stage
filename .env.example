# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000 # Browser origin.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1 # Public API base URL.
NEXT_PUBLIC_HEDERA_NETWORK=testnet # Wallet network shown to users.
NEXT_PUBLIC_WORLD_APP_ID=app_staging_replace_me # Public World app identifier.

# Backend
NODE_ENV=development # Runtime mode.
API_PORT=4000 # Fastify listen port.
WEB_ORIGIN=http://localhost:3000 # Allowed browser origin.
LOG_LEVEL=debug # Structured log threshold.

# PostgreSQL
POSTGRES_USER=creator # Local database user.
POSTGRES_PASSWORD=creator # Local-only database password.
POSTGRES_DB=creator_platform # Local database name.
DATABASE_URL=postgresql://creator:creator@localhost:5432/creator_platform?schema=public # Prisma connection URL.

# Redis / BullMQ
REDIS_URL=redis://localhost:6379 # Queue and coordination connection.
BULLMQ_PREFIX=creator-platform # Namespace for queue keys.

# S3-compatible storage
STORAGE_PROVIDER=minio # Use minio locally; r2 or s3 in deployment.
STORAGE_ENDPOINT=http://localhost:9000 # S3-compatible API endpoint.
STORAGE_REGION=auto # Region expected by the selected provider.
STORAGE_BUCKET=creator-platform # Submission artifact bucket.
STORAGE_ACCESS_KEY_ID=minio # Local access key; replace in deployment.
STORAGE_SECRET_ACCESS_KEY=change-me # Local secret; never commit a real value.
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/creator-platform # Public artifact base URL when enabled.
MINIO_ROOT_USER=minio # Optional local MinIO administrator.
MINIO_ROOT_PASSWORD=change-me # Optional local MinIO administrator password.

# Hedera writes (server only)
HEDERA_NETWORK=testnet # SDK network; mainnet must be blocked in MVP.
HEDERA_OPERATOR_ACCOUNT_ID=0.0.000000 # Testnet payer/operator account.
HEDERA_OPERATOR_PRIVATE_KEY=replace-with-testnet-private-key # Testnet secret, never expose to web.
HEDERA_TREASURY_ACCOUNT_ID=0.0.000000 # Platform treasury for MVP.
HEDERA_TREASURY_PRIVATE_KEY=replace-with-testnet-private-key # Treasury secret, server only.
HEDERA_SUPPLY_PRIVATE_KEY=replace-with-testnet-private-key # Token mint/burn authority, server only.
HEDERA_HCS_ADMIN_PRIVATE_KEY= # Optional topic administration authority.
HEDERA_HCS_SUBMIT_PRIVATE_KEY=replace-with-testnet-private-key # Audit submit authority, server only.
HEDERA_AUDIT_TOPIC_ID= # Existing HCS audit topic after setup.
HEDERA_REQUEST_TIMEOUT_MS=15000 # Bounded SDK request timeout.
HEDERA_RECEIPT_TIMEOUT_MS=30000 # Bounded receipt wait before reconciliation.
HEDERA_MAX_ATTEMPTS=3 # SDK attempts for the same transaction ID.
HEDERA_EXPLORER_BASE_URL=https://hashscan.io/testnet # Public transaction links.

# Hedera Mirror Node reads
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com # REST base URL.
HEDERA_MIRROR_NODE_API_KEY= # Optional provider API key.
HEDERA_MIRROR_REQUEST_TIMEOUT_MS=10000 # Wallet verification read timeout.
HEDERA_MIRROR_MAX_ATTEMPTS=4 # Bounded retries for transient Mirror failures.

# World Selfie Check
WORLD_APP_ID=app_staging_replace_me # Server-side World app identifier.
WORLD_ACTION=creator-platform-reward # Proof action checked by backend.
WORLD_API_URL=https://developer.worldcoin.org # Verification API base URL.
WORLD_API_KEY=replace-with-world-api-key # Server-only verification credential.
WORLD_SIGNAL_SECRET=replace-with-random-secret # HMAC key for user-bound signal.

# Sessions
SESSION_SECRET=replace-with-at-least-32-random-bytes # Cookie/session signing secret.
SESSION_COOKIE_NAME=creator_platform_session # Opaque login session cookie name.
SESSION_TTL_SECONDS=86400 # Session lifetime.
LOGIN_CHALLENGE_TTL_SECONDS=300 # Wallet login message lifetime.

# Observability
OTEL_SERVICE_NAME=creator-platform-api # OpenTelemetry service name.
OTEL_EXPORTER_OTLP_ENDPOINT= # Optional traces/metrics collector.
SENTRY_DSN= # Optional server error reporting DSN.
